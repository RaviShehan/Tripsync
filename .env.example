# ============================================================================
# TripSync - Root Environment Configuration (example)
# Copy to .env and rotate ALL secrets before any production deployment.
# ============================================================================

# --- General ---
APP_ENV=development
COMPOSE_PROJECT_NAME=tripsync

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tripsync

DATABASE_URL_PROPERTY=postgresql://postgres:change-me-postgres-password@localhost:5432/tripsync_property
DATABASE_URL_TOUR=postgresql://postgres:change-me-postgres-password@localhost:5432/tripsync_tour
DATABASE_URL_CAR=postgresql://postgres:change-me-postgres-password@localhost:5432/tripsync_car
DATABASE_URL_BOOKING=postgresql://postgres:change-me-postgres-password@localhost:5432/tripsync_booking

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# --- Kafka ---
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Vault ---
VAULT_HOST=vault
VAULT_PORT=8200
VAULT_TOKEN=change-me-vault-token
VAULT_UNSEAL_KEY=change-me-unseal-key

# --- Security / JWT ---
JWT_SECRET=change-me-32-character-minimum-jwt-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-32-char-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Microservice ports ---
API_GATEWAY_PORT=4000
TOUR_SERVICE_PORT=3000
PROPERTY_SERVICE_PORT=8081
CAR_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
FRONTEND_PORT=3001

# --- OAuth2 / OIDC ---
OAUTH2_CLIENT_ID=tripsync-web
OAUTH2_CLIENT_SECRET=change-me-oauth-client-secret
OIDC_ISSUER_URI=https://auth.tripsync.local/realms/tripsync

# --- Elastic Stack ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PASSWORD=change-me-elastic-password
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000
KIBANA_HOST=kibana
KIBANA_PORT=5601
